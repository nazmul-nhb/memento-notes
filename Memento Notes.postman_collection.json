  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Get the token from the environment variable",
          "const token = pm.environment.get('mementoToken');",
          "",
          "// Set the Authorization header automatically if the token exists",
          "if (token) {",
          "\tpm.request.headers.add({",
          "\t\tkey: 'Authorization',",
          "\t\tvalue: `Bearer ${token}`",
          "\t});",
          "",
          "\tconsole.log(token)",
          "}",
          ""
        ]
